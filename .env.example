POSTGRES_PASSWORD=dev-only-change-me
# Credenciales locales de MinIO para Docker Compose.
MINIO_ROOT_USER=urbanpulse-dev
MINIO_ROOT_PASSWORD=urbanpulse-dev-storage
URBANPULSE_STORAGE_BUCKET=urbanpulse-attachments
# Generar fuera de Git: openssl rand -base64 32
URBANPULSE_JWT_SECRET=
URBANPULSE_JWT_ISSUER=urbanpulse
URBANPULSE_JWT_AUDIENCE=urbanpulse-api
# Caducidad por defecto: 259200 segundos = 3 días.
URBANPULSE_JWT_TTL_SECONDS=259200
# Orígenes web exactos separados por comas. Vacío impide acceso desde otros orígenes web.
URBANPULSE_CORS_ALLOWED_ORIGINS=http://localhost:8081
